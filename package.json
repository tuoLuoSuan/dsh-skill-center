{
  "name": "dsh-skill-center",
  "version": "0.1.0",
  "description": "技能中心 — 在 DSH 里搜索、浏览、预览并一键安装来自全网的 Agent Skills（claudeskills.info / skillsmp / GitHub 官方与社区仓库 / DSH 技能包）。Skill Center for DeepSeek Harness.",
  "icon": "icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "skill",
    "skills",
    "skill-center",
    "技能中心"
  ],
  "license": "MIT",
  "author": "tuoLuoSuan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tuoLuoSuan/dsh-skill-center.git"
  },
  "homepage": "https://github.com/tuoLuoSuan/dsh-skill-center#readme",
  "bugs": {
    "url": "https://github.com/tuoLuoSuan/dsh-skill-center/issues"
  },
  "files": [
    "lib",
    "client",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
