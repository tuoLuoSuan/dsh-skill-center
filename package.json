{
  "name": "dsh-skill-center",
  "version": "0.2.3",
  "description": "在 DSH 侧边栏里搜索并安装 Agent Skills。装之前先体检（名字不合法的会被 DSH 静默跳过），装下来的是某一次 commit 而不是分支。",
  "icon": "icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "skill",
    "skills",
    "skill-center",
    "技能中心"
  ],
  "license": "MIT",
  "author": "tuoLuoSuan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tuoLuoSuan/dsh-skill-center.git"
  },
  "homepage": "https://github.com/tuoLuoSuan/dsh-skill-center#readme",
  "bugs": {
    "url": "https://github.com/tuoLuoSuan/dsh-skill-center/issues"
  },
  "files": [
    "lib",
    "client",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node docs/smoke-host.mjs && node docs/smoke-client.mjs && node docs/check-classes.mjs",
    "prepublishOnly": "node docs/audit-publish.mjs"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
