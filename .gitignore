# Dependencies — a plugin consumer installs this through DSH, never from here.
node_modules/
pnpm-lock.yaml
package-lock.json
yarn.lock

# Generated previews. `node docs/preview.mjs` rebuilds all of them from source.
docs/preview/
temp-*

# `npm pack` output. The tarball is built, never committed.
*.tgz

# Extracted from DeepSeek's own bundle, which is not ours to redistribute.
# Each one is regenerated by a script that reads your local DSH install:
#   node docs/extract-slot-catalog.mjs <.../dsh-cordis-client-runner/lib/client.js>
#   node docs/extract-api-catalogs.mjs <.../dsh-cordis-client-runner/lib/client.js>
#   node docs/theme-tokens.mjs
docs/slot-catalog*.json
docs/service-api*.json
docs/event-api*.json
docs/builtin-inspection*.json
docs/theme.css

# Probe output. `node docs/probe-dsh-plugins.mjs` rewrites it.
docs/probe-*.txt

# Editor and OS noise.
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
